# --------------------------------------
# macOS / OS noise
# --------------------------------------
.DS_Store

# --------------------------------------
# Editor / IDE
# --------------------------------------
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# --------------------------------------
# Anypoint Studio / Eclipse
# --------------------------------------
.classpath
.project
.settings/
.metadata/
.recommenders/
.mule/

# Ignore Anypoint Studio-generated Exchange docs
**/exchange-docs/

# Ignore DataWeave autogenerated preview artifacts
**/src/main/resources/weave/autogenerated/

# --------------------------------------
# Java / Maven / Mule build artifacts
# --------------------------------------
# Mule Maven Plugin / Maven generated temporary POMs
.*.pom
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# --------------------------------------
# Environment / secrets
# --------------------------------------
.env
.env.*
!.env.example

# Ignore environment-specific Mule application properties
**/src/main/resources/properties/app-props-*.yaml

# Ignore environment-specific Mule secure properties
**/src/main/resources/properties/secure-props-*.yaml

# Preserve configuration templates
!**/src/main/resources/properties/app-props.template.yaml
!**/src/main/resources/properties/secure-props.template.yaml

# --------------------------------------
# Logs
# --------------------------------------
*.log
logs/

# --------------------------------------
# Temporary files
# --------------------------------------
*.tmp
*.swp
*.swo
*.bak
*~

# --------------------------------------
# Private / local-only content
# --------------------------------------
_private/
